# Optional local secrets for testing server-backed features in `npm run local`.
# Copy this file to `.env.local` (which is gitignored) and fill in only what you want to test.
# Without `.env.local`, Treise runs offline-first with the built-in deterministic coach and local test scenarios.

# AI Coach live LLM proxy (/api/coach/generate)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Sign-In client ID (public)
# VITE_GOOGLE_CLIENT_ID=

# Optional Wearable / Activity OAuth credentials
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
